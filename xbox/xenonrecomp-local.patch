+inline PPCVRegister me_pack_u32_u16(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister result{};
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint32_t x = b.u32[i], y = a.u32[i];
+        if (x > 65535 || y > 65535) vscr |= 1;
+        result.u16[i] = uint16_t(x > 65535 ? 65535 : x);
+        result.u16[i + 4] = uint16_t(y > 65535 ? 65535 : y);
+    }
+    return result;
+}
+
+inline PPCVRegister me_float_to_u32_fixed(const PPCVRegister& input, unsigned scale, uint32_t& vscr)
+{
+    PPCVRegister result{};
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint32_t bits = input.u32[i];
+        const uint32_t fraction = bits & 0x7fffff;
+        const unsigned exponent = (bits >> 23) & 255;
+        const bool negative = (bits >> 31) != 0;
+        if (exponent == 255) {
+            if (fraction != 0) continue; // NaN converts to zero, no new saturation.
+            result.u32[i] = negative ? 0 : UINT32_MAX;
+            vscr |= 1;
+            continue;
+        }
+        const int integerExponent = int(exponent) - 127 + int(scale);
+        // All binary32 subnormals remain below 1 for an immediate scale <= 31.
+        if (exponent == 0 || integerExponent < 0) continue;
+        if (negative) { vscr |= 1; continue; }
+        if (integerExponent >= 32) { result.u32[i] = UINT32_MAX; vscr |= 1; continue; }
+        const uint32_t significand = fraction | 0x800000;
+        result.u32[i] = integerExponent >= 23
+            ? significand << (integerExponent - 23)
+            : significand >> (23 - integerExponent);
+    }
+    return result;
+}
+
+inline PPCVRegister me_pack_u16_u8(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister result{};
+    for (unsigned i = 0; i < 8; ++i) {
+        const uint16_t x = b.u16[i], y = a.u16[i];
+        if (x > 255 || y > 255) vscr |= 1;
+        result.u8[i] = uint8_t(x > 255 ? 255 : x);
+        result.u8[i + 8] = uint8_t(y > 255 ? 255 : y);
+    }
+    return result;
+}
+
+inline PPCVRegister me_pack_s32_s16(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister result{};
+    for (unsigned i = 0; i < 4; ++i) {
+        const int32_t x = b.s32[i], y = a.s32[i];
+        if (x < -32768 || x > 32767 || y < -32768 || y > 32767) vscr |= 1;
+        result.s16[i] = int16_t(x < -32768 ? -32768 : x > 32767 ? 32767 : x);
+        result.s16[i + 4] = int16_t(y < -32768 ? -32768 : y > 32767 ? 32767 : y);
+    }
+    return result;
+}
