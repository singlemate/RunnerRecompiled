@@ -0,0 +1,32 @@
+#pragma once
+#include <cstdint>
+#include <utility>
+#include <rex/system/mmio_handler.h>
+
+namespace rex::memory {
+// GPU-facing memory contract. Implementations own mappings and synchronization.
+// Physical translations retain the SDK 512 MiB mask and big-endian byte layout.
+// Invalidation semantics are those documented by Memory, not optional no-ops.
+class GpuMemory {
+ public:
+  virtual ~GpuMemory() = default;
+  virtual uint8_t* physical_membase() const = 0;
+  virtual bool IsPhysicalRangeValid(uint32_t address, uint32_t length) const {
+    return length && uint64_t(address & 0x1fffffff) + length <= 0x20000000ull;
+  }
+  // Legacy Memory uses fault-based watches. External polling providers override this.
+  virtual void SynchronizePhysicalWrites() {}
+  template <typename T = uint8_t*> T TranslatePhysical(uint32_t address) const {
+    auto* base = physical_membase();
+    return base ? reinterpret_cast<T>(base + (address & 0x1fffffff)) : nullptr;
+  }
+  virtual bool AddVirtualMappedRange(uint32_t address, uint32_t mask, uint32_t size,
+      void* context, runtime::MMIOReadCallback read, runtime::MMIOWriteCallback write) = 0;
+  using PhysicalMemoryInvalidationCallback = std::pair<uint32_t, uint32_t> (*)(
+      void*, uint32_t, uint32_t, bool);
+  virtual void* RegisterPhysicalMemoryInvalidationCallback(PhysicalMemoryInvalidationCallback,
+      void*) = 0;
+  virtual void UnregisterPhysicalMemoryInvalidationCallback(void*) = 0;
+  virtual void EnablePhysicalMemoryAccessCallbacks(uint32_t, uint32_t, bool, bool) = 0;
+};
+} // namespace rex::memory
