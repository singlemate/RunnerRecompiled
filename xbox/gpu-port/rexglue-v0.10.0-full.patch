+X_STATUS GraphicsSystem::SetupExternalGpu(memory::GpuMemory& memory, GuestExecutionHooks hooks,
+    std::function<bool(uint32_t, uint32_t, uint32_t, uint32_t)> interrupt,
+    uint32_t width, uint32_t height, float refresh) {
+  if (command_processor_ || !hooks.enter || !hooks.leave || !interrupt ||
+      !width || !height || !(refresh >= 1 && refresh <= 240)) return X_STATUS_UNSUCCESSFUL;
+  external_runtime_ = true; memory_ = &memory;
+  external_width_ = width; external_height_ = height; external_refresh_ = refresh;
+  external_interrupt_dispatcher_ = std::move(interrupt);
+  if (!provider_) CreateProvider(false);
+  if (!provider_) return X_STATUS_UNSUCCESSFUL;
+  command_processor_ = CreateCommandProcessor();
+  if (!command_processor_) return X_STATUS_UNSUCCESSFUL;
+  command_processor_->UseExternalHostWorker();
+  command_processor_->SetGuestExecutionHooks(hooks);
+  if (!command_processor_->Initialize()) return X_STATUS_UNSUCCESSFUL;
+  {
+    GuestExecutionGuard access(hooks);
+    if (!memory_->AddVirtualMappedRange(0x7fc80000, 0xffff0000, 0xffff, this,
+        reinterpret_cast<runtime::MMIOReadCallback>(ReadRegisterThunk),
+        reinterpret_cast<runtime::MMIOWriteCallback>(WriteRegisterThunk))) return X_STATUS_UNSUCCESSFUL;
+  }
+  command_processor_->SetDesiredSwapPostEffect(ParseSwapPostEffect(REXCVAR_GET(swap_post_effect)));
+  return X_STATUS_SUCCESS;
 }
 
