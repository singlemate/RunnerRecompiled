diff --git a/include/rex/graphics/guest_execution_guard.h b/include/rex/graphics/guest_execution_guard.h
new file mode 100644
index 0000000..428519b
--- /dev/null
+++ b/include/rex/graphics/guest_execution_guard.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <functional>
+#include <stdexcept>
+
+namespace rex::graphics {
+struct GuestExecutionHooks { std::function<void()> enter, leave; };
+// Worker-thread-only scope. Hooks must be paired; leave must not throw.
+class GuestExecutionGuard {
+ public:
+  explicit GuestExecutionGuard(const GuestExecutionHooks& hooks) : hooks_(hooks) {
+    if (bool(hooks.enter) != bool(hooks.leave)) throw std::invalid_argument("Guest gate hooks must be paired");
+    Acquire();
+  }
+  ~GuestExecutionGuard() { Release(); }
+  GuestExecutionGuard(const GuestExecutionGuard&) = delete;
+  void Acquire() { if (!held_ && hooks_.enter) { hooks_.enter(); held_ = true; } }
+  void Release() { if (held_) { held_ = false; hooks_.leave(); } }
+ private:
+  const GuestExecutionHooks& hooks_;
+  bool held_ = false;
+};
+class GuestExecutionBinding {
+ public:
+  GuestExecutionBinding(GuestExecutionGuard*& slot, const GuestExecutionHooks& hooks)
+      : slot_(slot), previous_(slot), guard_(hooks) { slot_ = &guard_; }
+  ~GuestExecutionBinding() { slot_ = previous_; }
+  GuestExecutionBinding(const GuestExecutionBinding&) = delete;
+ private:
+  GuestExecutionGuard*& slot_;
+  GuestExecutionGuard* previous_;
+  GuestExecutionGuard guard_;
+};
+} // namespace rex::graphics
diff --git a/include/rex/graphics/host_worker.h b/include/rex/graphics/host_worker.h
new file mode 100644
index 0000000..87c9af0
--- /dev/null
+++ b/include/rex/graphics/host_worker.h
@@ -0,0 +1,70 @@
+#pragma once
+#include <condition_variable>
+#include <exception>
+#include <functional>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace rex::graphics {
+// Host lifecycle only. Does not own guest scheduling or memory serialization.
+// One owner controls Start/Join/RequestPause/Resume; never Join from the worker.
+class HostWorker {
+ public:
+  ~HostWorker() { Join(); }
+  HostWorker() = default;
+  HostWorker(const HostWorker&) = delete;
+  bool Start(std::function<void()> run) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (started_ || !run) return false;
+    started_ = true;
+    try {
+      thread_ = std::thread([this, run = std::move(run)] {
+        current_ = this;
+        try { run(); }
+        catch (...) { std::lock_guard<std::mutex> lock(mutex_); failure_ = std::current_exception(); }
+        current_ = nullptr;
+      });
+    } catch (...) { started_ = false; return false; }
+    return true;
+  }
+  // Waits for setup on the worker. False/exception prevents run from starting.
+  // Caller must release locks needed by setup before entering this method.
+  bool StartReady(std::function<bool()> setup, std::function<void()> run) {
+    if (!setup || !run) return false;
+    auto ready = std::make_shared<std::promise<bool>>();
+    auto result = ready->get_future();
+    if (!Start([setup = std::move(setup), run = std::move(run), ready] {
+      bool initialized;
+      try { initialized = setup(); }
+      catch (...) { ready->set_exception(std::current_exception()); throw; }
+      ready->set_value(initialized);
+      if (initialized) run();
+    })) return false;
+    bool initialized = false;
+    try { initialized = result.get(); }
+    catch (...) { Join(); return false; }
+    if (!initialized) Join();
+    return initialized;
+  }
+  bool IsCurrentThread() const { return current_ == this; }
+  void RequestPause() { std::lock_guard<std::mutex> lock(mutex_); paused_ = true; }
+  void PauseCurrent() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    changed_.wait(lock, [this] { return !paused_; });
+  }
+  void Resume() {
+    std::lock_guard<std::mutex> lock(mutex_); paused_ = false; changed_.notify_all();
+  }
+  void Join() { Resume(); if (thread_.joinable()) thread_.join(); }
+  std::exception_ptr failure() const { std::lock_guard<std::mutex> lock(mutex_); return failure_; }
+ private:
+  static inline thread_local HostWorker* current_ = nullptr;
+  mutable std::mutex mutex_;
+  std::condition_variable changed_;
+  std::thread thread_;
+  bool started_ = false, paused_ = false;
+  std::exception_ptr failure_;
+};
+} // namespace rex::graphics
