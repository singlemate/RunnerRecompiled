+// vkResetCommandPool was 13.8% of the command processor's cycles in the profile (the
+// Adreno driver frees its per-command-buffer memory there). Pools of completed
+// submissions go to a worker that resets them; the command processor takes reset pools
+// from the ready list and no longer resets them itself. A pool is owned by exactly one
+// side at a time, so the external synchronization Vulkan requires holds.
+// ME_GPU_ASYNC_POOL_RESET=0 restores the synchronous reset.
+namespace {
+struct MePoolResetWorker {
+  std::mutex mutex;
+  std::condition_variable changed;
+  std::deque<std::pair<VkCommandPool, VkCommandBuffer>> pending, ready;
+  bool busy = false, started = false;
+  VkDevice device = VK_NULL_HANDLE;
+  PFN_vkResetCommandPool reset = nullptr;
+  uint64_t resets = 0, failures = 0;
+  static bool Enabled() {
+    static const bool enabled = [] {
+      const char* v = std::getenv("ME_GPU_ASYNC_POOL_RESET");
+      return !(v && !std::strcmp(v, "0"));
+    }();
+    return enabled;
+  }
+  void Enqueue(VkDevice dev, PFN_vkResetCommandPool fn, VkCommandPool pool, VkCommandBuffer buffer) {
+    std::unique_lock<std::mutex> lock(mutex);
+    device = dev;
+    reset = fn;
+    pending.emplace_back(pool, buffer);
+    if (!started) {
+      started = true;
+      std::thread([this] { Run(); }).detach();
+    }
+    changed.notify_all();
+  }
+  void Run() {
+    std::unique_lock<std::mutex> lock(mutex);
+    for (;;) {
+      changed.wait(lock, [this] { return !pending.empty(); });
+      auto item = pending.front();
+      pending.pop_front();
+      busy = true;
+      lock.unlock();
