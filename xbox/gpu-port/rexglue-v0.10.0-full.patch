+// Mirror's Edge Android port: driver pipeline cache saved next to the pipeline storage
+// (vulkan_pipeline_cache.bin), so pipelines recreated from storage at startup and new
+// ones in later sessions come from the driver cache instead of a full compile. Created in
+// InitializeShaderStorage; saved in the background after every 16 new pipelines (the
+// process is killed, never shut down). VkPipelineCache is internally synchronized.
+VkPipelineCache me_vk_pipeline_cache = VK_NULL_HANDLE;
+std::filesystem::path me_vk_pipeline_cache_path;
+std::atomic<uint32_t> me_vk_pipelines_created{0};
+std::atomic<bool> me_vk_pipeline_cache_saving{false};
+PFN_vkGetPipelineCacheData me_vk_get_pipeline_cache_data = nullptr;
+VkDevice me_vk_pipeline_cache_device = VK_NULL_HANDLE;
+
+void MeOpenPipelineCache(const ui::vulkan::VulkanDevice* vulkan_device,
+                         const std::filesystem::path& root) {
+  if (me_vk_pipeline_cache != VK_NULL_HANDLE) return;
+  const auto& ifn = vulkan_device->vulkan_instance()->functions();
+  const VkDevice device = vulkan_device->device();
+  auto create = reinterpret_cast<PFN_vkCreatePipelineCache>(
+      ifn.vkGetDeviceProcAddr(device, "vkCreatePipelineCache"));
+  me_vk_get_pipeline_cache_data = reinterpret_cast<PFN_vkGetPipelineCacheData>(
+      ifn.vkGetDeviceProcAddr(device, "vkGetPipelineCacheData"));
+  if (!create || !me_vk_get_pipeline_cache_data) return;
+  me_vk_pipeline_cache_path = root / "vulkan_pipeline_cache.bin";
+  std::vector<uint8_t> data;
+  if (FILE* file = std::fopen(rex::path_to_utf8(me_vk_pipeline_cache_path).c_str(), "rb")) {
+    std::fseek(file, 0, SEEK_END);
+    const long size = std::ftell(file);
+    std::fseek(file, 0, SEEK_SET);
+    if (size > 0 && size < (256l << 20)) {
+      data.resize(size_t(size));
+      if (std::fread(data.data(), 1, data.size(), file) != data.size()) data.clear();
+    }
+    std::fclose(file);
+  }
+  VkPipelineCacheCreateInfo info = {VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = data.size();
+  info.pInitialData = data.empty() ? nullptr : data.data();
+  VkResult result = create(device, &info, nullptr, &me_vk_pipeline_cache);
+  if (result != VK_SUCCESS && !data.empty()) {
+    // Incompatible or corrupt (driver update): start empty.
+    info.initialDataSize = 0;
+    info.pInitialData = nullptr;
+    result = create(device, &info, nullptr, &me_vk_pipeline_cache);
+  }
+  if (result != VK_SUCCESS) me_vk_pipeline_cache = VK_NULL_HANDLE;
+  me_vk_pipeline_cache_device = device;
+  std::printf("{\"event\":\"vulkan_pipeline_cache\",\"loaded_bytes\":%zu,\"ok\":%s}\n", data.size(),
+              me_vk_pipeline_cache != VK_NULL_HANDLE ? "true" : "false");
+}
+
+void MeSavePipelineCacheAsync() {
+  if (me_vk_pipeline_cache == VK_NULL_HANDLE || me_vk_pipeline_cache_saving.exchange(true)) return;
+  std::thread([] {
+    size_t size = 0;
+    std::vector<uint8_t> data;
+    if (me_vk_get_pipeline_cache_data(me_vk_pipeline_cache_device, me_vk_pipeline_cache, &size,
+                                      nullptr) == VK_SUCCESS && size) {
+      data.resize(size);
+      if (me_vk_get_pipeline_cache_data(me_vk_pipeline_cache_device, me_vk_pipeline_cache, &size,
+                                        data.data()) != VK_SUCCESS)
+        data.clear();
+      data.resize(size);
+    }
+    if (!data.empty()) {
+      const std::string path = rex::path_to_utf8(me_vk_pipeline_cache_path);
+      const std::string temp = path + ".tmp";
+      if (FILE* file = std::fopen(temp.c_str(), "wb")) {
+        const bool ok = std::fwrite(data.data(), 1, data.size(), file) == data.size();
+        if (std::fclose(file) == 0 && ok) std::rename(temp.c_str(), path.c_str());
+      }
+    }
+    me_vk_pipeline_cache_saving.store(false);
+  }).detach();
+}
