diff --git a/src/ui/vulkan/vulkan_presenter_window.cpp b/src/ui/vulkan/vulkan_presenter_window.cpp
new file mode 100644
index 0000000..c32613c
--- /dev/null
+++ b/src/ui/vulkan/vulkan_presenter_window.cpp
@@ -0,0 +1,467 @@
+// Mirror's Edge Android port: direct presentation of the guest output into an
+// ANativeWindow for the external (headless) GPU host build, where the regular
+// Window/Surface painting path is unavailable. The guest output image is blitted
+// (letterboxed, linear filter) into a FIFO swapchain image; no UI drawers.
+// State lives in a side table keyed by the presenter, so VulkanPresenter's layout
+// is unchanged and objects compiled against the original header stay valid.
+
+#include <rex/ui/vulkan/presenter.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <android/native_window.h>
+
+#include <rex/ui/vulkan/util.h>
+
+namespace rex {
+namespace ui {
+namespace vulkan {
+
+namespace {
+
+struct ExternalWindowState {
+  ANativeWindow* window = nullptr;
+  VkSurfaceKHR surface = VK_NULL_HANDLE;
+  VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+  VkFormat format = VK_FORMAT_UNDEFINED;
+  VkExtent2D extent = {};
+  bool recreate = false;
+  std::vector<VkImage> images;
+  std::vector<VkSemaphore> release_semaphores;  // per swapchain image
+  PFN_vkCmdBlitImage cmd_blit_image = nullptr;  // not in RexGlue's device table
+  struct Frame {
+    VkCommandPool command_pool = VK_NULL_HANDLE;
+    VkCommandBuffer command_buffer = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    VkSemaphore acquire_semaphore = VK_NULL_HANDLE;
+    std::shared_ptr<void> guest_image;  // kept alive until the fence signals
+  };
+  std::array<Frame, 2> frames;
+  uint32_t frame_index = 0;
+  uint64_t presented = 0;
+  // Mailbox index of the last presented guest image. The producer always refreshes a
+  // different slot than the consumer holds, so an unchanged index means no new frame.
+  uint32_t last_mailbox = UINT32_MAX;
+  // Phase timing of presented frames (us), logged every 5 s as display_phases: does the
+  // display path hold the shared graphics queue long enough to delay the command processor?
+  struct Phase { uint64_t sum = 0, max = 0; void add(uint64_t v) { sum += v; max = std::max(max, v); } };
+  Phase fence, acquire, lock_wait, locked, present, total;
+  uint64_t timed = 0;
+  std::chrono::steady_clock::time_point timing_start = std::chrono::steady_clock::now();
+};
+
+uint64_t ElapsedUs(std::chrono::steady_clock::time_point since) {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - since).count());
+}
+
+std::mutex external_windows_mutex;
+std::unordered_map<const void*, ExternalWindowState> external_windows;
+
+void WaitFrames(const VulkanDevice* device, ExternalWindowState& state) {
+  const VulkanDevice::Functions& dfn = device->functions();
+  for (auto& frame : state.frames) {
+    if (frame.fence) dfn.vkWaitForFences(device->device(), 1, &frame.fence, VK_TRUE, 2000000000ull);
+    frame.guest_image.reset();
+  }
+}
+
+void DestroySwapchain(const VulkanDevice* device, ExternalWindowState& state) {
+  const VulkanDevice::Functions& dfn = device->functions();
+  WaitFrames(device, state);
+  for (VkSemaphore semaphore : state.release_semaphores)
+    dfn.vkDestroySemaphore(device->device(), semaphore, nullptr);
+  state.release_semaphores.clear();
+  state.images.clear();
+  if (state.swapchain) dfn.vkDestroySwapchainKHR(device->device(), state.swapchain, nullptr);
+  state.swapchain = VK_NULL_HANDLE;
+}
+
+void DestroyAll(const VulkanDevice* device, ExternalWindowState& state) {
+  const VulkanDevice::Functions& dfn = device->functions();
+  DestroySwapchain(device, state);
+  for (auto& frame : state.frames) {
+    if (frame.fence) dfn.vkDestroyFence(device->device(), frame.fence, nullptr);
+    if (frame.acquire_semaphore)
+      dfn.vkDestroySemaphore(device->device(), frame.acquire_semaphore, nullptr);
+    if (frame.command_pool) dfn.vkDestroyCommandPool(device->device(), frame.command_pool, nullptr);
+    frame = {};
+  }
+  if (state.surface) {
+    const VulkanInstance* instance = device->vulkan_instance();
+    instance->functions().vkDestroySurfaceKHR(instance->instance(), state.surface, nullptr);
+  }
+  state.surface = VK_NULL_HANDLE;
+  state.window = nullptr;
+}
+
+bool CreateSurfaceAndFrames(const VulkanDevice* device, ExternalWindowState& state,
+                            ANativeWindow* window) {
+  const VulkanInstance* instance = device->vulkan_instance();
+  const VulkanInstance::Functions& ifn = instance->functions();
+  const VulkanDevice::Functions& dfn = device->functions();
+  if (!instance->extensions().ext_KHR_android_surface || !ifn.vkCreateAndroidSurfaceKHR ||
+      !device->extensions().ext_KHR_swapchain) {
+    std::printf("{\"event\":\"display_unsupported\",\"android_surface\":%s,\"swapchain\":%s}\n",
+                instance->extensions().ext_KHR_android_surface ? "true" : "false",
+                device->extensions().ext_KHR_swapchain ? "true" : "false");
+    return false;
+  }
+  VkAndroidSurfaceCreateInfoKHR surface_info = {VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR};
+  surface_info.window = window;
+  if (ifn.vkCreateAndroidSurfaceKHR(instance->instance(), &surface_info, nullptr, &state.surface) !=
+      VK_SUCCESS) {
+    std::printf("{\"event\":\"display_surface_failed\"}\n");
+    return false;
+  }
+  state.window = window;
+  VkBool32 supported = VK_FALSE;
+  ifn.vkGetPhysicalDeviceSurfaceSupportKHR(device->physical_device(),
+                                           device->queue_family_graphics_compute(), state.surface,
+                                           &supported);
+  if (!supported) {
+    std::printf("{\"event\":\"display_queue_cannot_present\"}\n");
+    return false;
+  }
+  state.cmd_blit_image = reinterpret_cast<PFN_vkCmdBlitImage>(
+      ifn.vkGetDeviceProcAddr(device->device(), "vkCmdBlitImage"));
+  if (!state.cmd_blit_image) return false;
+  for (auto& frame : state.frames) {
+    VkCommandPoolCreateInfo pool_info = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    pool_info.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+    pool_info.queueFamilyIndex = device->queue_family_graphics_compute();
+    if (dfn.vkCreateCommandPool(device->device(), &pool_info, nullptr, &frame.command_pool) !=
+        VK_SUCCESS)
+      return false;
+    VkCommandBufferAllocateInfo allocate_info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    allocate_info.commandPool = frame.command_pool;
+    allocate_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    allocate_info.commandBufferCount = 1;
+    VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    fence_info.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+    VkSemaphoreCreateInfo semaphore_info = {VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+    if (dfn.vkAllocateCommandBuffers(device->device(), &allocate_info, &frame.command_buffer) !=
+            VK_SUCCESS ||
+        dfn.vkCreateFence(device->device(), &fence_info, nullptr, &frame.fence) != VK_SUCCESS ||
+        dfn.vkCreateSemaphore(device->device(), &semaphore_info, nullptr,
+                              &frame.acquire_semaphore) != VK_SUCCESS)
+      return false;
+  }
+  return true;
+}
+
+bool CreateSwapchain(const VulkanDevice* device, ExternalWindowState& state) {
+  const VulkanInstance::Functions& ifn = device->vulkan_instance()->functions();
+  const VulkanDevice::Functions& dfn = device->functions();
+  VkSurfaceCapabilitiesKHR caps;
+  if (ifn.vkGetPhysicalDeviceSurfaceCapabilitiesKHR(device->physical_device(), state.surface,
+                                                    &caps) != VK_SUCCESS)
+    return false;
+  if (!(caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_DST_BIT)) {
+    std::printf("{\"event\":\"display_no_transfer_dst\"}\n");
+    return false;
+  }
+  VkExtent2D extent = caps.currentExtent;
+  if (extent.width == UINT32_MAX) {
+    extent.width = uint32_t(std::max(1, ANativeWindow_getWidth(state.window)));
+    extent.height = uint32_t(std::max(1, ANativeWindow_getHeight(state.window)));
+  }
+  if (!extent.width || !extent.height) return false;
+  uint32_t format_count = 0;
+  ifn.vkGetPhysicalDeviceSurfaceFormatsKHR(device->physical_device(), state.surface, &format_count,
+                                           nullptr);
+  std::vector<VkSurfaceFormatKHR> formats(format_count);
+  ifn.vkGetPhysicalDeviceSurfaceFormatsKHR(device->physical_device(), state.surface, &format_count,
+                                           formats.data());
+  if (formats.empty()) return false;
+  // The guest output is already display-encoded: prefer a UNORM format so the
+  // blit copies values unchanged (an SRGB swapchain would encode them twice).
+  VkSurfaceFormatKHR chosen = formats[0];
+  for (const VkSurfaceFormatKHR& format : formats) {
+    if (format.format == VK_FORMAT_R8G8B8A8_UNORM || format.format == VK_FORMAT_B8G8R8A8_UNORM) {
+      chosen = format;
+      break;
+    }
+  }
+  VkSwapchainCreateInfoKHR info = {VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+  info.surface = state.surface;
+  info.minImageCount = std::max(caps.minImageCount, 3u);
+  if (caps.maxImageCount) info.minImageCount = std::min(info.minImageCount, caps.maxImageCount);
+  info.imageFormat = chosen.format;
+  info.imageColorSpace = chosen.colorSpace;
+  info.imageExtent = extent;
+  info.imageArrayLayers = 1;
+  info.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  info.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  // Identity: the compositor rotates if the display is not in its natural orientation.
+  info.preTransform = (caps.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR)
+                          ? VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR
+                          : caps.currentTransform;
+  info.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+  for (VkCompositeAlphaFlagBitsKHR alpha :
+       {VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR, VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR,
+        VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR, VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR}) {
+    if (caps.supportedCompositeAlpha & alpha) {
+      info.compositeAlpha = alpha;
+      break;
+    }
+  }
+  info.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+  info.clipped = VK_TRUE;
+  info.oldSwapchain = state.swapchain;
+  VkSwapchainKHR swapchain;
+  const VkResult result = dfn.vkCreateSwapchainKHR(device->device(), &info, nullptr, &swapchain);
+  DestroySwapchain(device, state);
+  if (result != VK_SUCCESS) {
+    std::printf("{\"event\":\"display_swapchain_failed\",\"result\":%d}\n", int(result));
+    return false;
+  }
+  state.swapchain = swapchain;
+  state.format = chosen.format;
+  state.extent = extent;
+  uint32_t image_count = 0;
+  dfn.vkGetSwapchainImagesKHR(device->device(), swapchain, &image_count, nullptr);
+  state.images.resize(image_count);
+  dfn.vkGetSwapchainImagesKHR(device->device(), swapchain, &image_count, state.images.data());
+  VkSemaphoreCreateInfo semaphore_info = {VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  state.release_semaphores.resize(image_count, VK_NULL_HANDLE);
+  for (VkSemaphore& semaphore : state.release_semaphores)
+    if (dfn.vkCreateSemaphore(device->device(), &semaphore_info, nullptr, &semaphore) != VK_SUCCESS)
+      return false;
+  state.recreate = false;
+  state.last_mailbox = UINT32_MAX;  // new images: present the current frame again
+  std::printf(
+      "{\"event\":\"display_swapchain\",\"width\":%u,\"height\":%u,\"format\":%d,\"images\":%u,"
+      "\"transform\":%u}\n",
+      extent.width, extent.height, int(chosen.format), image_count, unsigned(caps.currentTransform));
+  return true;
+}
+
+}  // namespace
+
+int VulkanPresenter::PresentGuestOutputToWindow(void* native_window) {
+  ANativeWindow* window = static_cast<ANativeWindow*>(native_window);
+  if (!window) return -1;
+  std::lock_guard<std::mutex> lock(external_windows_mutex);
+  ExternalWindowState& state = external_windows[this];
+  const VulkanDevice* device = vulkan_device_;
+  const VulkanDevice::Functions& dfn = device->functions();
+  if (state.window != window) {
+    DestroyAll(device, state);
+    if (!CreateSurfaceAndFrames(device, state, window)) {
+      DestroyAll(device, state);
+      return -1;
+    }
+  }
+  // Android reports VK_SUBOPTIMAL_KHR on every present while the display is rotated
+  // relative to the identity preTransform, so that is not a reason to recreate; a window
+  // size change is (checked here, OUT_OF_DATE is not guaranteed for it).
+  if (state.swapchain &&
+      (uint32_t(ANativeWindow_getWidth(window)) != state.extent.width ||
+       uint32_t(ANativeWindow_getHeight(window)) != state.extent.height))
+    state.recreate = true;
+  if (!state.swapchain || state.recreate) {
+    if (!CreateSwapchain(device, state)) return -1;
+  }
+
+  std::shared_ptr<GuestOutputImage> guest_output_image;
+  uint32_t guest_output_mailbox_index;
+  {
+    std::unique_lock<std::mutex> guest_output_consumer_lock(
+        ConsumeGuestOutput(guest_output_mailbox_index, nullptr, nullptr));
+    if (guest_output_mailbox_index != UINT32_MAX)
+      guest_output_image = guest_output_images_[guest_output_mailbox_index].image;
+  }
+  if (!guest_output_image) return 0;
+  if (guest_output_mailbox_index == state.last_mailbox) return 0;  // no new guest frame
+
+  const auto t_begin = std::chrono::steady_clock::now();
+  ExternalWindowState::Frame& frame = state.frames[state.frame_index];
+  if (dfn.vkWaitForFences(device->device(), 1, &frame.fence, VK_TRUE, 2000000000ull) != VK_SUCCESS)
+    return -1;
+  frame.guest_image.reset();
+  state.fence.add(ElapsedUs(t_begin));
+
+  const auto t_acquire = std::chrono::steady_clock::now();
+  uint32_t image_index;
+  VkResult result = dfn.vkAcquireNextImageKHR(device->device(), state.swapchain, 2000000000ull,
+                                              frame.acquire_semaphore, VK_NULL_HANDLE,
+                                              &image_index);
+  if (result == VK_ERROR_OUT_OF_DATE_KHR) {
+    state.recreate = true;
+    return -1;
+  }
+  if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR) {
+    return -1;
+  }
+
+  state.acquire.add(ElapsedUs(t_acquire));
+  VkCommandBuffer command_buffer = frame.command_buffer;
+  dfn.vkResetCommandPool(device->device(), frame.command_pool, 0);
+  VkCommandBufferBeginInfo begin_info = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  dfn.vkBeginCommandBuffer(command_buffer, &begin_info);
+
+  const VkImage target = state.images[image_index];
+  std::array<VkImageMemoryBarrier, 2> barriers;
+  barriers[0] = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+  barriers[0].srcAccessMask = 0;
+  barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barriers[0].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+  barriers[0].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barriers[0].image = target;
+  barriers[0].subresourceRange = util::InitializeSubresourceRange();
+  barriers[1] = barriers[0];
+  barriers[1].srcAccessMask = kGuestOutputInternalAccessMask;
+  barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  barriers[1].oldLayout = kGuestOutputInternalLayout;
+  barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  barriers[1].image = guest_output_image->image();
+  dfn.vkCmdPipelineBarrier(command_buffer,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT | kGuestOutputInternalStageMask,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr,
+                           uint32_t(barriers.size()), barriers.data());
+
+  // Letterbox: clear to black, then scale the guest image to fit preserving aspect.
+  VkClearColorValue black = {};
+  const VkImageSubresourceRange range = util::InitializeSubresourceRange();
+  dfn.vkCmdClearColorImage(command_buffer, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1,
+                           &range);
+  VkMemoryBarrier clear_barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  clear_barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  clear_barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &clear_barrier, 0, nullptr, 0,
+                           nullptr);
+  const VkExtent2D source = guest_output_image->extent();
+  const uint64_t sw = source.width, sh = source.height, dw = state.extent.width,
+                 dh = state.extent.height;
+  uint32_t width = uint32_t(dw), height = uint32_t(dw * sh / sw);
+  if (height > dh) {
+    height = uint32_t(dh);
+    width = uint32_t(dh * sw / sh);
+  }
+  const int32_t x = int32_t((dw - width) / 2), y = int32_t((dh - height) / 2);
+  VkImageBlit blit = {};
+  blit.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  blit.srcSubresource.layerCount = 1;
+  blit.srcOffsets[1] = {int32_t(source.width), int32_t(source.height), 1};
+  blit.dstSubresource = blit.srcSubresource;
+  blit.dstOffsets[0] = {x, y, 0};
+  blit.dstOffsets[1] = {x + int32_t(width), y + int32_t(height), 1};
+  state.cmd_blit_image(command_buffer, guest_output_image->image(),
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+
+  barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barriers[0].dstAccessMask = 0;
+  barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+  barriers[0].newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+  std::swap(barriers[1].srcAccessMask, barriers[1].dstAccessMask);
+  std::swap(barriers[1].oldLayout, barriers[1].newLayout);
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT | kGuestOutputInternalStageMask, 0,
+                           0, nullptr, 0, nullptr, uint32_t(barriers.size()), barriers.data());
+  if (dfn.vkEndCommandBuffer(command_buffer) != VK_SUCCESS) return -1;
+
+  const VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  VkSubmitInfo submit_info = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit_info.waitSemaphoreCount = 1;
+  submit_info.pWaitSemaphores = &frame.acquire_semaphore;
+  submit_info.pWaitDstStageMask = &wait_stage;
+  submit_info.commandBufferCount = 1;
+  submit_info.pCommandBuffers = &command_buffer;
+  submit_info.signalSemaphoreCount = 1;
+  submit_info.pSignalSemaphores = &state.release_semaphores[image_index];
+  dfn.vkResetFences(device->device(), 1, &frame.fence);
+  VkPresentInfoKHR present_info = {VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+  present_info.waitSemaphoreCount = 1;
+  present_info.pWaitSemaphores = &state.release_semaphores[image_index];
+  present_info.swapchainCount = 1;
+  present_info.pSwapchains = &state.swapchain;
+  present_info.pImageIndices = &image_index;
+  // The blit is submitted to queue 0, after the command processor's work that produced
+  // the guest image (same queue = submission order). vkQueuePresentKHR goes to queue 1 of
+  // the same family when the device has it (it waits on the release semaphore and may
+  // block for vsync); ME_DISPLAY_PRESENT_QUEUE=0 presents on queue 0 as before.
+  static const uint32_t present_queue = [device] {
+    const char* v = std::getenv("ME_DISPLAY_PRESENT_QUEUE");
+    const bool separate = !(v && !std::strcmp(v, "0")) &&
+        device->queue_families()[device->queue_family_graphics_compute()].queues.size() > 1;
+    std::printf("{\"event\":\"display_present_queue\",\"index\":%u}\n", separate ? 1u : 0u);
+    return separate ? 1u : 0u;
+  }();
+  VkResult present_result = VK_SUCCESS;
+  {
+    const auto t_lock = std::chrono::steady_clock::now();
+    const VulkanDevice::Queue::Acquisition queue_acquisition =
+        device->AcquireQueue(device->queue_family_graphics_compute(), 0);
+    state.lock_wait.add(ElapsedUs(t_lock));
+    const auto t_locked = std::chrono::steady_clock::now();
+    result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, frame.fence);
+    if (result != VK_SUCCESS) {
+      // The acquire semaphore stays signaled; rebuild everything next time.
+      state.window = nullptr;
+      return -1;
+    }
+    if (!present_queue) {
+      const auto t_present = std::chrono::steady_clock::now();
+      present_result = dfn.vkQueuePresentKHR(queue_acquisition.queue(), &present_info);
+      state.present.add(ElapsedUs(t_present));
+    }
+    state.locked.add(ElapsedUs(t_locked));
+  }
+  if (present_queue) {
+    const auto t_present = std::chrono::steady_clock::now();
+    const VulkanDevice::Queue::Acquisition present_acquisition =
+        device->AcquireQueue(device->queue_family_graphics_compute(), present_queue);
+    present_result = dfn.vkQueuePresentKHR(present_acquisition.queue(), &present_info);
+    state.present.add(ElapsedUs(t_present));
+  }
+  state.total.add(ElapsedUs(t_begin));
+  if (++state.timed && ElapsedUs(state.timing_start) >= 5000000) {
+    const double n = double(state.timed);
+    std::printf(
+        "{\"event\":\"display_phases\",\"frames\":%llu,\"fence_us\":[%.0f,%llu],"
+        "\"acquire_us\":[%.0f,%llu],\"queue_lock_wait_us\":[%.0f,%llu],"
+        "\"queue_locked_us\":[%.0f,%llu],\"present_us\":[%.0f,%llu],\"total_us\":[%.0f,%llu]}\n",
+        (unsigned long long)state.timed, state.fence.sum / n, (unsigned long long)state.fence.max,
+        state.acquire.sum / n, (unsigned long long)state.acquire.max, state.lock_wait.sum / n,
+        (unsigned long long)state.lock_wait.max, state.locked.sum / n,
+        (unsigned long long)state.locked.max, state.present.sum / n,
+        (unsigned long long)state.present.max, state.total.sum / n,
+        (unsigned long long)state.total.max);
+    state.fence = state.acquire = state.lock_wait = state.locked = state.present = state.total = {};
+    state.timed = 0;
+    state.timing_start = std::chrono::steady_clock::now();
+  }
+  frame.guest_image = guest_output_image;
+  state.last_mailbox = guest_output_mailbox_index;
+  state.frame_index = (state.frame_index + 1) % uint32_t(state.frames.size());
+  if (present_result == VK_ERROR_OUT_OF_DATE_KHR) state.recreate = true;
+  ++state.presented;
+  return present_result == VK_SUCCESS || present_result == VK_SUBOPTIMAL_KHR ? 1 : -1;
+}
+
+void VulkanPresenter::ReleaseExternalWindow() {
+  std::lock_guard<std::mutex> lock(external_windows_mutex);
+  auto it = external_windows.find(this);
+  if (it == external_windows.end()) return;
+  DestroyAll(vulkan_device_, it->second);
+  external_windows.erase(it);
+}
